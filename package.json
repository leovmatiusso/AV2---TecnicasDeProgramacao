{
  "name": "greencode",
  "version": "1.0.0",
  "private": true,
  "description": "CLI de logística reversa de equipamentos eletrônicos - AV1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "dev": "tsx src/cli.ts",
    "start:api": "node dist/src/api/server.js",
    "dev:api": "tsx src/api/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npm run build && node dist/prisma/seed.js",
    "jornada:api": "npm run build && node dist/scripts/jornada-api.js",
    "jornada": "npm run build && node dist/scripts/jornada.js",
    "test": "npm run build && node --test dist/src/core.test.js dist/src/crud.test.js dist/src/api/app.test.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "prisma": "^6.19.0",
    "pg": "^8.16.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
